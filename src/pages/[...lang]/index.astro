---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import ToothChart from '../../components/ToothChart.astro';
import AppointmentCard from '../../components/AppointmentCard.astro';
import Btn from '../../components/Btn.astro';
import { ui } from '../../i18n/ui';
import { langMeta, path, staticLangPaths, type Lang } from '../../i18n/langs';
import { services, doctors } from '../../data/clinic';

export const getStaticPaths = staticLangPaths;
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const arrow = '<svg class="dir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const welcome = { ru: 'Добро пожаловать', uz: 'Xush kelibsiz', kk: 'Қош келдіңіз', en: 'Welcome', ar: 'أهلاً وسهلاً' }[lang];
const look = { ru: 'Смотреть', uz: 'Ko‘rish', kk: 'Көру', en: 'View', ar: 'عرض' }[lang];
const times = ['09:00', '10:30', '12:00', '14:00', '15:30', '17:00', '18:30'];
// Alatau ridge line, used at the foot of the hero and the footer
const ridge = 'M0 120 L90 70 L150 95 L230 30 L300 80 L360 55 L430 100 L520 20 L600 75 L660 50 L740 90 L820 35 L900 85 L980 60 L1060 100 L1140 40 L1220 80 L1300 55 L1440 110';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Alatau Smile',
  telephone: t.contacts.phone,
  address: { '@type': 'PostalAddress', streetAddress: 'Timiryazev 42', addressLocality: 'Almaty', addressCountry: 'KZ' },
  openingHours: 'Mo-Su 09:00-21:00',
  priceRange: '₸₸',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '212' },
  availableLanguage: ['ru', 'kk', 'en'],
  inLanguage: langMeta[lang].locale,
};
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} schema={schema}>
  <div class="kpre" data-preloader aria-hidden="true">
    <div class="flex flex-col items-center gap-6">
      <span class="relative block size-24 rounded-full" data-pre-in style="box-shadow:0 0 0 6px #E9EEF2,0 0 0 7px rgba(12,26,43,.2);background:radial-gradient(circle at 35% 30%,#fff,#D6E7F0 70%)"></span>
      <span class="overflow-hidden"><span class="block text-[28px] font-light tracking-[-0.03em]" data-pre-text>{welcome}</span></span>
    </div>
  </div>
  <div class="kprogress" data-progress-bar aria-hidden="true"></div>
  <div class="kcursor" data-cursor-el aria-hidden="true"><span class="kcursor-dot"></span><span class="kcursor-label" data-cursor-label></span></div>
  <header class="sticky top-0 z-40 bg-snow/85 backdrop-blur-xl">
    <div class="mx-auto flex h-18 max-w-[1440px] items-center gap-6 px-5 md:px-10">
      <a href={path(lang)} class="me-auto flex items-center gap-2.5 text-[19px] font-medium tracking-[-0.02em]">
        <span class="relative grid size-8 place-items-center rounded-full bg-ink"><span class="size-4 rounded-full border-2 border-coral"></span></span>
        Alatau Smile
      </a>
      <nav class="hidden items-center gap-8 text-[15px] text-slate lg:flex" aria-label={t.nav.services}>
        <a class="hover:text-ink" href="#services">{t.nav.services}</a>
        <a class="hover:text-ink" href="#doctors">{t.nav.doctors}</a>
        <a class="hover:text-ink" href="#contacts">{t.nav.contacts}</a>
      </nav>
      <LangSwitch lang={lang} label={t.nav.lang} />
      <Btn href="#book" icon={false} class="!hidden !h-11 !px-5 !text-[15px] sm:!inline-flex">{t.nav.book}</Btn>
    </div>
  </header>

  <!-- HERO -->
  <section class="relative overflow-hidden" data-hero>
    <div class="mx-auto grid max-w-[1440px] items-center gap-10 px-5 pb-24 pt-8 md:px-10 lg:grid-cols-[1fr_0.95fr] lg:gap-16 lg:pb-32 lg:pt-12">
      <div class="relative z-10">
        <p class="eyebrow" data-reveal>{t.hero.eyebrow}</p>
        <h1 class="d-hero mt-5 max-w-[9ch]" data-split>{t.hero.title}</h1>
        <p class="mt-7 max-w-[40ch] text-[19px] leading-relaxed text-slate" data-reveal>{t.hero.text}</p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal>
          <Btn href="#book">{t.hero.cta}</Btn>
          <Btn href="#services" variant="line">{t.hero.secondary}</Btn>
        </div>
        <ul class="mt-12 flex flex-wrap gap-x-6 gap-y-2 text-[14px] text-slate" data-reveal>
          {t.trust.map((x) => <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-coral"></span>{x}</li>)}
        </ul>
      </div>

      <div class="relative" data-reveal>
        <div class="card relative aspect-[4/5] touch-none select-none" dir="ltr" data-mirror-area data-wipe>
          <Photo name="hero" alt={t.hero.title} eager class="before" position="center 30%" sizes="(min-width: 1024px) 45vw, 100vw" />
          <div class="mirror" data-mirror hidden>
            <div class="mirror-handle"></div>
            <div class="mirror-lens"><span class="mirror-tag">{t.hero.after}</span></div>
          </div>
          <span class="absolute start-5 top-5 rounded-full bg-paper/90 px-3 py-1.5 text-[12px] font-medium uppercase tracking-[.06em] backdrop-blur">{t.hero.before}</span>
          <div class="absolute bottom-4 end-4 z-10 flex items-center gap-3 rounded-2xl bg-paper px-5 py-4 shadow-[0_25px_50px_-20px_rgba(12,26,43,.35)]" data-float>
          <span class="relative flex size-2.5"><span class="absolute inline-flex size-full animate-ping rounded-full bg-coral opacity-60"></span><span class="relative size-2.5 rounded-full bg-coral"></span></span>
          <span class="text-[14px] leading-tight"><span class="text-slate">{t.doctors.next}</span><br /><b class="num text-[17px] font-medium" dir="ltr">16:30</b></span>
        </div>
        </div>
        <p class="mt-4 flex items-center gap-2 text-[14px] text-slate">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m14.5 14.5 6 6"/></svg>
          {t.hero.hint}
        </p>
      </div>
    </div>
    <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-[120px] w-full text-glacier-deep" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true"><path d={ridge} fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke" /></svg>
  </section>

  <div class="kmarquee border-b border-line bg-paper py-7" data-marquee="34" aria-hidden="true">
    <div data-marquee-track>
      {[0, 1].map(() => services.map((s) => <span class="flex items-center gap-8 pe-8 text-[clamp(36px,4.6vw,68px)] font-light leading-none tracking-[-0.04em]">{s.name[lang]}<span class="size-5 rounded-full border-2 border-coral"></span></span>))}
    </div>
  </div>

  <!-- SERVICES -->
  <section id="services" class="scroll-mt-20 bg-paper py-24 lg:py-32">
    <div class="mx-auto max-w-[1440px] px-5 md:px-10">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="d-xl" data-split>{t.services.title}</h2>
        <p class="max-w-[38ch] text-slate" data-reveal>{t.services.text}</p>
      </div>
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <article class="group" data-reveal>
            <div class="relative aspect-[4/3] overflow-hidden rounded-[24px] bg-glacier" data-zoom data-wipe data-tilt="4" data-cursor={look}>
              <Photo name={`service-${s.id}`} alt={s.name[lang]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw" class="transition-transform duration-[1.2s] group-hover:scale-105" />
            </div>
            <div class="mt-5 flex items-start justify-between gap-4">
              <div>
                <h3 class="d-l">{s.name[lang]}</h3>
                <p class="mt-1.5 text-[15px] text-slate">{s.text[lang]}</p>
              </div>
              <p class="num shrink-0 pt-1.5 text-[15px] text-slate"><span class="text-[12px]">{t.services.from}</span> <b class="text-[18px] font-medium text-ink" dir="ltr" data-count>{s.price} ₸</b></p>
            </div>
            <a href="#book" data-service={s.id} class="mt-4 inline-flex items-center gap-2 text-[15px] font-medium text-coral">{t.services.book}<Fragment set:html={arrow} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DOCTORS -->
  <section id="doctors" class="scroll-mt-20 py-24 lg:py-32">
    <div class="mx-auto max-w-[1440px] px-5 md:px-10">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="d-xl" data-split>{t.doctors.title}</h2>
        <p class="max-w-[34ch] text-slate" data-reveal>{t.doctors.text}</p>
      </div>
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {doctors.map((d) => (
          <article class="card flex flex-col p-2.5" data-reveal data-tilt="4">
            <div class="relative aspect-[4/5] overflow-hidden rounded-[20px] bg-glacier" data-zoom>
              <Photo name={`doctor-${d.id}`} alt={d.name[lang]} position="center 20%" sizes="(min-width: 768px) 30vw, 100vw" />
              <p class="absolute start-3 top-3 flex items-center gap-2 rounded-full bg-paper/92 px-3 py-1.5 text-[13px] backdrop-blur">
                <span class="size-2 rounded-full bg-coral"></span>{t.doctors.next} <b class="num font-medium" dir="ltr">{d.slot}</b>
              </p>
            </div>
            <div class="flex flex-1 flex-col px-3.5 pb-3.5 pt-5">
              <h3 class="d-l">{d.name[lang]}</h3>
              <p class="mt-1 text-[15px] text-slate">{d.role[lang]}</p>
              <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-line pt-4 text-[14px]">
                <div><dt class="text-slate">{t.doctors.years}</dt><dd class="num mt-0.5 text-[20px] font-medium" data-count>{d.years}</dd></div>
                <div><dt class="text-slate">{t.doctors.speaks}</dt><dd class="mt-1 font-medium" dir="ltr">{d.langs}</dd></div>
              </dl>
              <a href="#book" data-doctor={d.id} class="kbtn kbtn-line press mt-6 w-full justify-between" data-magnetic="0.1"><span>{t.doctors.book}</span><span class="ico" set:html={arrow + arrow} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BOOKING -->
  <section id="book" class="scroll-mt-20 px-3 md:px-5">
    <div class="mx-auto grid max-w-[1440px] gap-10 rounded-[36px] bg-glacier px-5 py-16 md:px-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:py-24">
      <div>
        <h2 class="d-xl" data-split>{t.chart.title}</h2>
        <p class="mt-5 max-w-[38ch] text-slate" data-reveal>{t.chart.text}</p>
        <div class="mt-8 max-w-[440px]" data-reveal><ToothChart lang={lang} t={t.chart} /></div>
      </div>
      <form class="card self-start p-6 md:p-9" data-invite novalidate data-reveal>
        <h3 class="d-l">{t.book.title}</h3>
        <p class="mt-2 text-[15px] text-slate">{t.book.text}</p>
        <div class="mt-5 flex items-center justify-between gap-4 rounded-2xl bg-snow px-5 py-4">
          <span class="text-[14px] text-slate">{t.book.tooth}</span>
          <span id="tooth-out" class="text-end text-[15px] font-medium">{t.chart.none}</span>
        </div>
        <input type="hidden" name="tooth" id="f-tooth" data-label={t.book.tooth} />
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-[14px] text-slate">{t.book.name}<input class="input" name="name" autocomplete="name" required data-label={t.book.patient} /></label>
          <label class="grid gap-2 text-[14px] text-slate">{t.book.phone}<input class="input" name="phone" type="tel" autocomplete="tel" required dir="ltr" /></label>
          <label class="grid gap-2 text-[14px] text-slate">{t.book.service}
            <select class="input" name="service" data-label={t.book.service}><option value="consult">{t.book.consult}</option>{services.map((s) => <option value={s.id}>{s.name[lang]}</option>)}</select>
          </label>
          <label class="grid gap-2 text-[14px] text-slate">{t.book.doctor}
            <select class="input" name="doctor" data-label={t.book.doctor}><option value="">{t.book.anyDoctor}</option>{doctors.map((d) => <option value={d.id}>{d.name[lang]}</option>)}</select>
          </label>
          <label class="grid gap-2 text-[14px] text-slate">{t.book.date}<input class="input" name="date" type="date" required data-label={t.book.date} /></label>
          <label class="grid gap-2 text-[14px] text-slate">{t.book.time}<select class="input num" name="time" data-label={t.book.time}>{times.map((x) => <option>{x}</option>)}</select></label>
        </div>
        <button type="submit" class="kbtn kbtn-coral press mt-7 w-full justify-between" data-magnetic="0.1"><span>{t.book.submit}</span><span class="ico" set:html={arrow + arrow} /></button>
      </form>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto grid max-w-[1440px] gap-12 px-5 md:px-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 class="d-xl" data-split>{t.reviews.title}</h2>
        <p class="mt-8 flex items-baseline gap-4" data-reveal><span class="num text-[clamp(80px,9vw,140px)] font-light leading-none tracking-[-0.05em] text-coral" dir="ltr" data-count>{t.reviews.rating}</span><span class="text-slate">{t.reviews.count}</span></p>
      </div>
      <div class="grid gap-4">
        {t.reviews.items.map((r, i) => (
          <figure class="card flex gap-5 p-6 transition-transform duration-500 hover:-translate-y-1 md:p-8" data-reveal>
            <div class="relative size-14 shrink-0 overflow-hidden rounded-full bg-glacier"><Photo name={`patient-${i + 1}`} alt="" sizes="60px" label={false} /></div>
            <div>
              <blockquote class="text-[18px] leading-snug">{r.text}</blockquote>
              <figcaption class="mt-3 text-[14px] text-slate">{r.name} · <span class="text-coral" dir="ltr">★★★★★</span></figcaption>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTS -->
  <footer id="contacts" class="relative overflow-hidden bg-ink text-snow">
    <svg class="pointer-events-none absolute inset-x-0 top-10 h-[120px] w-full text-snow/15" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true"><path d={ridge} fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke" /></svg>
    <div class="relative mx-auto max-w-[1440px] px-5 pb-10 pt-40 md:px-10">
      <h2 class="d-hero" data-split>{t.contacts.title}</h2>
      <dl class="mt-16 grid gap-8 border-t border-snow/15 pt-10 sm:grid-cols-2 lg:grid-cols-4">
        <div><dt class="text-[13px] text-snow/55">{t.contacts.addressLabel}</dt><dd class="mt-2">{t.contacts.address}<br /><a class="mt-1 inline-block text-coral hover:underline" href="https://2gis.kz/almaty" target="_blank" rel="noopener">{t.contacts.route}</a></dd></div>
        <div><dt class="text-[13px] text-snow/55">{t.contacts.hoursLabel}</dt><dd class="mt-2">{t.contacts.hours}</dd></div>
        <div><dt class="text-[13px] text-snow/55">{t.contacts.phoneLabel}</dt><dd class="num mt-2" dir="ltr">{t.contacts.phone}</dd></div>
        <div><dt class="text-[13px] text-snow/55">{t.contacts.now}</dt><dd class="num mt-2" data-clock="Asia/Almaty"></dd></div>
      </dl>
      <p class="mt-16 text-[12px] text-snow/45">{t.footer}</p>
    </div>
  </footer>

  <AppointmentCard t={t.book} address={t.contacts.address} locale={langMeta[lang].locale} />
</Base>

<script>
  import { gsap } from 'gsap';

  // Dentist's mirror: the lens shows the photo without the "before" tint
  const area = document.querySelector<HTMLElement>('[data-mirror-area]');
  const base = area?.querySelector<HTMLImageElement>('img.before');
  const mirror = area?.querySelector<HTMLElement>('[data-mirror]');
  if (area && base && mirror) {
    const lens = mirror.querySelector<HTMLElement>('.mirror-lens')!;
    const clone = document.createElement('img');
    clone.alt = '';
    clone.style.objectPosition = base.style.objectPosition;
    lens.prepend(clone);
    const sync = () => { clone.src = base.currentSrc || base.src; };
    base.complete ? sync() : base.addEventListener('load', sync);
    mirror.hidden = false;

    const pos = { x: 0, y: 0 };
    const size = () => mirror.offsetWidth;
    function place() {
      const r = size() / 2;
      const w = area!.clientWidth, h = area!.clientHeight;
      mirror!.style.transform = `translate(${pos.x - r}px, ${pos.y - r}px)`;
      Object.assign(clone.style, { width: `${w}px`, height: `${h}px`, left: `${-(pos.x - r)}px`, top: `${-(pos.y - r)}px` });
    }
    // Idle: the mirror drifts slowly over the smile until the visitor takes it
    let idle = true;
    const t0 = performance.now();
    gsap.ticker.add(() => {
      if (!idle) return;
      const t = (performance.now() - t0) / 1000;
      pos.x = area.clientWidth * (0.5 + 0.18 * Math.sin(t * 0.6));
      pos.y = area.clientHeight * (0.42 + 0.08 * Math.sin(t * 1.2));
      place();
    });
    const xTo = gsap.quickTo(pos, 'x', { duration: 0.35, ease: 'power3', onUpdate: place });
    const yTo = gsap.quickTo(pos, 'y', { duration: 0.35, ease: 'power3', onUpdate: place });
    area.addEventListener('pointermove', (e) => {
      const r = area.getBoundingClientRect();
      if (idle) { idle = false; }
      xTo(e.clientX - r.left);
      yTo(e.clientY - r.top);
    });
    area.addEventListener('pointerdown', (e) => area.setPointerCapture(e.pointerId));
    window.addEventListener('resize', place);
  }

  // Tooth chart selection feeds the booking form
  const out = document.getElementById('tooth-out')!;
  const field = document.getElementById('f-tooth') as HTMLInputElement;
  const noneText = out.textContent;
  const num = document.getElementById('chart-num');
  function pick(g: SVGGElement | null) {
    document.querySelectorAll('.tooth').forEach((x) => x.setAttribute('aria-pressed', String(x === g)));
    const v = g ? `${g.dataset.tooth} · ${g.dataset.name}` : '';
    field.value = v;
    out.textContent = v || noneText;
    if (num) num.textContent = g?.dataset.tooth || '';
  }
  document.querySelectorAll<SVGGElement>('.tooth').forEach((g) => {
    const toggle = () => pick(g.getAttribute('aria-pressed') === 'true' ? null : g);
    g.addEventListener('click', toggle);
    g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
  });

  // "Book" links on services and doctors preselect the form
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('[data-service],[data-doctor]');
    if (!a) return;
    const f = document.querySelector<HTMLFormElement>('form[data-invite]')!;
    if (a.dataset.service) (f.elements.namedItem('service') as HTMLSelectElement).value = a.dataset.service;
    if (a.dataset.doctor) (f.elements.namedItem('doctor') as HTMLSelectElement).value = a.dataset.doctor;
  });
  const date = document.querySelector<HTMLInputElement>('input[type="date"]');
  if (date) date.min = new Date().toISOString().slice(0, 10);
</script>
